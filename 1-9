                        meta.data.forEach((bar, index) => {
                            const data = dataset.data[index];
                            if (data > 0) {
                                ctx.fillStyle = '#5a4848';
                                ctx.font = 'bold 10px Arial';
                                ctx.textAlign = 'center';
                                ctx.fillText(data.toFixed(2), bar.x, bar.y - 5);
                            }
                        });
                    }
                }
            }]
        });
        
        // 6. 机型维度满意度对比图（只给最新版本加数据标签，并支持图例联动）
        const deviceCtx = document.getElementById('deviceComparisonChart').getContext('2d');
        const deviceData = [{"device": "M2", "V1.7": 71.88, "V1.8": 85.57, "V1.9": 88.14}, {"device": "O1", "V1.7": 0, "V1.8": 0, "V1.9": 86.92}, {"device": "S1", "V1.7": 83.29, "V1.8": 84.21, "V1.9": 89.47}, {"device": "F2", "V1.7": 80.74, "V1.8": 92.55, "V1.9": 90.44}, {"device": "DT001", "V1.7": 86.73, "V1.8": 80.43, "V1.9": 83.09}, {"device": "F2 Ultra UV", "V1.7": 79.92, "V1.8": 82.84, "V1.9": 82.26}];
        
        // 使用反转后的版本顺序，与国家图表保持一致
        const deviceDatasets = reversedVersions.map((version, index) => {
            const colors = ['#667eea', '#c5a8bf', '#e8a87c'];
            return {
                label: version,
                data: deviceData.map(item => item[version] || 0),
                backgroundColor: colors[index % 3]
            };
        });
        
        const deviceComparisonChart = new Chart(deviceCtx, {
            type: 'bar',
            data: {
                labels: deviceData.map(item => item.device),
                datasets: deviceDatasets
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { 
                        position: 'top',
                        onClick: function(e, legendItem, legend) {
                            // 默认图例点击行为
                            const index = legendItem.datasetIndex;
                            const chart = legend.chart;
                            const meta = chart.getDatasetMeta(index);
                            meta.hidden = meta.hidden === null ? !chart.data.datasets[index].hidden : null;
                            chart.update();
                        }
                    }
                },
                scales: {
                    x: { 
                        beginAtZero: true,
                        max: 100
                    }
                }
            },
            plugins: [{
                afterDatasetsDraw: function(chart) {
                    const ctx = chart.ctx;
                    // 找到第一个可见的数据集（最新版本）
                    let latestVisibleIndex = -1;
                    for (let i = 0; i < chart.data.datasets.length; i++) {
                        const meta = chart.getDatasetMeta(i);
                        if (!meta.hidden) {
                            latestVisibleIndex = i;
                            break;
                        }
                    }
                    
                    // 只给第一个可见的数据集添加标签
                    if (latestVisibleIndex >= 0) {
                        const dataset = chart.data.datasets[latestVisibleIndex];
                        const meta = chart.getDatasetMeta(latestVisibleIndex);
                        meta.data.forEach((bar, index) => {
                            const data = dataset.data[index];
                            if (data > 0) {
                                ctx.fillStyle = '#5a4848';
                                ctx.font = 'bold 10px Arial';
                                ctx.textAlign = 'left';
                                ctx.fillText(data.toFixed(2), bar.x + 5, bar.y + 4);
                            }
                        });
                    }
                }
            }]
        });
        
    </script>
</body>
</html>
